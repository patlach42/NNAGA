desc:bench reverb (FDN-ish, EEL RAM delay lines)
slider1:0.7<0,1,0.001>size
slider2:0.3<0,1,0.001>mix

@init
// four delay lines, ~1.5 s total of doubles -> crosses several 64K-item blocks
d0 = 0;      l0 = 44497;
d1 = l0;     l1 = 45083;
d2 = d1+l1;  l2 = 46073;
d3 = d2+l2;  l3 = 47051;
p0 = p1 = p2 = p3 = 0;
lp0 = lp1 = lp2 = lp3 = 0;

@slider
fb = 0.5 + slider1 * 0.49;
wet = slider2;

@sample
a0 = d0[p0]; a1 = d1[p1]; a2 = d2[p2]; a3 = d3[p3];
// hadamard-ish feedback matrix
s0 = a0 + a1 + a2 + a3;
s1 = a0 - a1 + a2 - a3;
s2 = a0 + a1 - a2 - a3;
s3 = a0 - a1 - a2 + a3;
in = (spl0 + spl1) * 0.25;
lp0 = lp0 + 0.4 * (s0 * 0.5 - lp0);
lp1 = lp1 + 0.4 * (s1 * 0.5 - lp1);
lp2 = lp2 + 0.4 * (s2 * 0.5 - lp2);
lp3 = lp3 + 0.4 * (s3 * 0.5 - lp3);
d0[p0] = in + lp0 * fb;
d1[p1] = in + lp1 * fb;
d2[p2] = in + lp2 * fb;
d3[p3] = in + lp3 * fb;
p0 = (p0 + 1) % l0; p1 = (p1 + 1) % l1;
p2 = (p2 + 1) % l2; p3 = (p3 + 1) % l3;
spl0 = spl0 * (1-wet) + (a0 + a2) * wet * 0.5;
spl1 = spl1 * (1-wet) + (a1 + a3) * wet * 0.5;
