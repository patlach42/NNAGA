+static ULONG STDMETHODCALLTYPE dcomp_device_AddRef(IDCompositionDevice *iface)
+{
+    struct dcomp_device *device = impl_from_IDCompositionDevice(iface);
+    ULONG refcount = InterlockedIncrement(&device->refcount);
