+    if (context->stencil_dsv)
+    {
+        ID3D11DepthStencilView_Release(context->stencil_dsv);
+        context->stencil_dsv = NULL;
+    }
+    if (context->stencil_texture)
+    {
+        ID3D11Texture2D_Release(context->stencil_texture);
+        context->stencil_texture = NULL;
+    }
