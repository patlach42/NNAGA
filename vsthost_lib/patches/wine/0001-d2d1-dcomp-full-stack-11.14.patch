+    struct convolve_matrix_properties *props = (struct convolve_matrix_properties *)(effect + 1);
+    UINT32 size = props->kernel_matrix_size;
+
+    if (actual_size)
+        *actual_size = size;
+
+    if (data && data_size)
+    {
+        if (data_size < size)
+            return E_NOT_SUFFICIENT_BUFFER;
+        memcpy(data, props->kernel_matrix, size);
