+                unsigned int h = HIWORD(dims);
+                BitBlt(ps.hdc, 0, 0, w, h, comp_dc, 0, 0, SRCCOPY);
+            }
+            EndPaint(hwnd, &ps);
+            ValidateRect(hwnd, NULL);
+            return 0;
+        }
