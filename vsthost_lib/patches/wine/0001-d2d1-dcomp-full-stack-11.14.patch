+static HRESULT STDMETHODCALLTYPE d3d11_fence_SetPrivateData(ID3D11Fence *iface,
+        REFGUID guid, UINT data_size, const void *data)
+{
+    struct d3d11_fence *fence = impl_from_ID3D11Fence(iface);
