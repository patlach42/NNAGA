+        *out = &visual->IDCompositionVisual_iface;
+        IDCompositionVisual_AddRef(*out);
+        return S_OK;
+    }
+
+    FIXME("unsupported iid %s.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
